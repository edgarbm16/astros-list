---
import { getCollection } from 'astro:content';
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';

const products = await getCollection('products')

export const prerender = true;
---

<div id="container">
	<main class="place-content-center grid bg-gradient-to-b from-black to-gray-900 xl:h-screen xl:[@media(max-height:991px)]:h-[66rem]">
		<section class="my-20">
			<div class="container md:px-0 px-5 sm:px-10">
				<h1 class="text-4xl font-bold text-center text-white">
					Product's list
				</h1>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
					{
						products.map(product => {
							const {slug, data} = product
							const {title, seller, img, quantity, description, buy} = data

							return (
								<article>
									<a href={`/products/${slug}`} class="flex flex-col gap-y-5 items-center hover:brightness-90 transition-all bg-white rounded-lg shadow-lg p-6 sm:h-[29rem] xl:h-[27rem]">
										<img 
											transition:name={`img-${slug}`}
											src={`images/${img}`} width="0" height="0" loading="lazy" alt={title} title={title} class="w-full h-48 object-contain rounded-t-lg" />
										<div class="h-44">
											<div class="flex flex-col h-full justify-between">
												<div>
													<h2 transition:name={`title-${slug}`}
														class="text-xl font-semibold mt-4">{title}</h3>
													<p class="text-gray-600 mt-2">{description}</p>
												</div>
												<p class="text-gray-500 mt-2">Cantidad: {quantity}</p>
											</div>
										</div>
									</a>
								</article>
							)
						})
					}
				</div>
			</div>
		</section>
	</main>
</div>

